# Firebase web app configuration (public values; create a dedicated Firebase app).
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Platform (property wizard: Places autocomplete + map pin).
# Browser key restricted by HTTP referrer to Maps JavaScript API and Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (JavaScript, vector) from Google Cloud > Map Management; empty uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional local Emulator Suite endpoints.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Server-only Firebase Admin configuration.
FIREBASE_PROJECT_ID=
# Firebase Auth UID authorized to create the first organization.
FIREBASE_BOOTSTRAP_ADMIN_UID=
# Organization whose published short-stay units appear in the public catalog (/estancias, /stays).
PUBLIC_CATALOG_ORGANIZATION_ID=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Property images are stored on the server's disk (outside public/). Defaults to ./storage.
LOCAL_STORAGE_DIR=
# Set GOOGLE_APPLICATION_CREDENTIALS to a local service-account file path,
# or use Application Default Credentials in the hosting environment.
